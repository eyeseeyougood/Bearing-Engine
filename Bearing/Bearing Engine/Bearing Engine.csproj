<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Bearing</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>True</CopyLocalLockFileAssemblies>
    <IncludeNativeLibrariesForSelfExtract>True</IncludeNativeLibrariesForSelfExtract>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="EngineData\Textures\" />
    <Folder Include="Resources\Audio\SFX\" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <PackageReference Include="OpenAL-Soft.Win" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AssimpNet" Version="4.1.0" />
    <PackageReference Include="BulletSharp" Version="0.11.1" />
    <PackageReference Include="Box2D.NET" Version="3.1.645" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="OpenTK.Mathematics" Version="4.9.4" />
    <PackageReference Include="RiptideNetworking.Riptide" Version="2.2.0" />
    <PackageReference Include="Silk.Net.Input" Version="2.22.0" />
    <PackageReference Include="Silk.NET.OpenAL" Version="2.22.0" />
    <PackageReference Include="Silk.NET.OpenAL.Extensions.Enumeration" Version="2.22.0" />
    <PackageReference Include="Silk.Net.OpenGL" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.22.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.1" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
  </ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\**\*" />
		<EmbeddedResource Include="EngineData\**\*" />
	</ItemGroup>
	
	<ItemGroup>
	  <None Remove="EngineData\Shaders\defaultUI.frag" />
	  <None Remove="EngineData\Shaders\defaultUI.vert" />
	  <None Remove="Resources\Shaders\defaultUI.frag" />
	  <None Remove="Resources\Shaders\defaultUI.vert" />
	</ItemGroup>

  <Target Name="CopyExtraLinuxLibraries" AfterTargets="Publish">

    <PropertyGroup>
      <ExtraLibsDir>$(ProjectDir)bin\Release\ExtraLibs</ExtraLibsDir>
    </PropertyGroup>

    <!-- WARNING WARNING WARNING !!!! this is a potential failure point -->
    <!-- I haven't tested this outside of linux environment -->
    <!-- maybe the symlink copying may brake on windows?? -->
    <Copy SourceFiles="
        $(ExtraLibsDir)\libopenal.so.1;
        $(ExtraLibsDir)\libminizip.so.1;
        $(ExtraLibsDir)\libdl.so"
      DestinationFolder="$(PublishDir)"
      Condition="'$(RuntimeIdentifier)' == 'linux-x64' and $([System.OperatingSystem]::IsLinux())"
      SkipUnchangedFiles="true" />

    <Exec
      Command="patchelf --set-rpath '$ORIGIN' '$(PublishDir)libassimp.so'"
      Condition="'$(RuntimeIdentifier)' == 'linux-x64' and $([System.OperatingSystem]::IsLinux())"
      ContinueOnError="true" />
  </Target>

</Project>
